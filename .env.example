# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Public variables exposed to client for Supabase Auth, Client SDK, and W3C Web Push
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_VAPID_PUBLIC_KEY="your-vapid-public-key-base64url"

# Server-only secrets (Configure in Supabase Edge Function secrets ONLY — NEVER prefix with VITE_ or expose to browser):
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
WEBHOOK_SECRET="generate-with-openssl-rand-hex-32"
VAPID_PUBLIC_KEY="your-vapid-public-key-base64url"
VAPID_PRIVATE_KEY="your-vapid-private-key-base64url"
VAPID_SUBJECT="mailto:realgauravpatel@gmail.com"
GITHUB_TOKEN="optional-github-personal-access-token"
